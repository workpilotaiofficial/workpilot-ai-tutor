# Firebase Web SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Existing study-set backend
NEXT_PUBLIC_API_BASE_URL=/backend-api
API_UPSTREAM_URL=https://your-backend.example.com

# Server-only Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional: point the unchanged browser chat client at the future backend.
# Until then, leave this empty so it calls the local Next.js route.
NEXT_PUBLIC_CHAT_API_BASE_URL=
